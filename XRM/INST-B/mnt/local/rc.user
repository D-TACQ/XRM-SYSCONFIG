# DEFAULT init for acq425, 10000000 Hz, auto soft trigger
#
# created by deploy_sysconfig for uut:acq2206_099 mezz:acq425
# by dt100@eigg-fs on Tue 31 Mar 08:47:53 BST 2026
# git 9c5642451ef85f85303bcd7695335253dd8a23ed
# incant SR=10000000 ./deploy_sysconfig.sh acq2206_099 WR acq425 1 2

/usr/local/CARE/acq2206\+acq42x.init
# Local clock and soft trigger
set.site 0 sync_role master 4000000
# Alternate front panel clock and front panel trigger
#set.site 0 sync_role fpmaster 10000000 1000000

# For other combinations try 'set.site 0 sync_role help'

# CYCLE TRIGGER direct from front panel                                                                
caput $(hostname):0:SIG:SRC:TRG:0 EXT
# Burst mode: no LIVE PRE                                                  
caput $(hostname):LIVE:PREPCT 0 

# enable port 4210 stream
echo STREAM_OPTS= >> /etc/sysconfig/acq400_streamd.conf

# Tune WR clock phase
set.site 11 si5326_tune_phase 1

